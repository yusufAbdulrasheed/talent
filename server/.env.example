NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Connection string for MongoDB (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/tms

# Must be at least 32 characters each, and different from one another.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Paystack signs webhooks with the secret key, so no separate webhook secret.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:5173/talent/payment/callback

# Training fee in naira. Required in production; payments fail without it.
TRAINING_FEE_NGN=

# Omit the SMTP block in development and emails are logged to the console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM=TMS <no-reply@example.com>

# Used only by `npm run seed:admin --workspace=server`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
